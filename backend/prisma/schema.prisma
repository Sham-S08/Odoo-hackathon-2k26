generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  MANAGER
  FINANCE_MANAGER
  CUSTOMER
}

enum CustomerTier {
  BRONZE
  SILVER
  GOLD
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CUSTOMER_REVIEW
  NEGOTIATION
  CUSTOMER_ACCEPTED
  CONVERTED
  COMPLETED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  CREATED
  ALLOCATED
  FULFILLED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

model Company {
  id            String         @id @default(cuid())
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  customers     Customer[]
  products      Product[]
  discountRules DiscountRule[]
  warehouses    Warehouse[]
  quotations    Quotation[]
  orders        SalesOrder[]
  invoices      Invoice[]
  auditLogs     AuditLog[]
  inventories   Inventory[]
}

model User {
  id           String      @id @default(cuid())
  companyId    String
  customerId   String?
  name         String
  email        String      @unique
  passwordHash String
  role         Role
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  quotations   Quotation[] @relation("QuotationCreatedBy")
  approvals    Approval[]  @relation("ManagerApprovals")
  auditLogs    AuditLog[]
}

model Customer {
  id           String         @id @default(cuid())
  companyId    String
  name         String
  email        String
  phone        String?
  tier         CustomerTier   @default(BRONZE)
  status       CustomerStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users        User[]
  quotations   Quotation[]
  orders       SalesOrder[]
  negotiations Negotiation[]

  @@index([companyId])
}

model Product {
  id                   String                @id @default(cuid())
  companyId            String
  sku                  String
  name                 String
  description          String?
  category             String
  type                 String?
  basePrice            Decimal               @db.Decimal(15, 2)
  taxRate              Decimal               @db.Decimal(5, 2)
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotationItems       QuotationItem[]
  orderItems           SalesOrderItem[]
  inventory            Inventory[]
  inventoryAllocations InventoryAllocation[]

  @@unique([companyId, sku])
  @@index([companyId, category])
}

model DiscountRule {
  id                 String        @id @default(cuid())
  companyId          String
  customerTier       CustomerTier?
  productCategory    String?
  maxDiscountPercent Decimal       @db.Decimal(5, 2)
  active             Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  company            Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, customerTier, productCategory])
}

model Quotation {
  id             String             @id @default(cuid())
  companyId      String
  customerId     String
  createdById    String
  status         QuotationStatus    @default(DRAFT)
  versionNumber  Int                @default(1)
  notes          String?            @db.Text
  subtotal       Decimal            @db.Decimal(15, 2)
  discountTotal  Decimal            @db.Decimal(15, 2)
  taxTotal       Decimal            @db.Decimal(15, 2)
  total          Decimal            @db.Decimal(15, 2)
  rulePassed     Boolean            @default(false)
  ruleViolations Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer       Customer           @relation(fields: [customerId], references: [id])
  createdBy      User               @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  items          QuotationItem[]
  versions       QuotationVersion[]
  approvals      Approval[]
  negotiations   Negotiation[]
  dealHealth     DealHealth[]
  salesOrder     SalesOrder?

  @@index([companyId, status])
  @@index([customerId])
}

model QuotationItem {
  id              String    @id @default(cuid())
  quotationId     String
  productId       String
  quantity        Int
  unitPrice       Decimal   @db.Decimal(15, 2)
  discountPercent Decimal   @db.Decimal(5, 2)
  discountAmount  Decimal   @db.Decimal(15, 2)
  taxRate         Decimal   @db.Decimal(5, 2)
  taxAmount       Decimal   @db.Decimal(15, 2)
  lineTotal       Decimal   @db.Decimal(15, 2)
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id])

  @@index([quotationId])
}

model QuotationVersion {
  id            String          @id @default(cuid())
  quotationId   String
  versionNumber Int
  status        QuotationStatus
  subtotal      Decimal         @db.Decimal(15, 2)
  discountTotal Decimal         @db.Decimal(15, 2)
  taxTotal      Decimal         @db.Decimal(15, 2)
  total         Decimal         @db.Decimal(15, 2)
  notes         String?         @db.Text
  snapshot      Json
  createdAt     DateTime        @default(now())
  quotation     Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([quotationId, versionNumber])
}

model Approval {
  id          String         @id @default(cuid())
  quotationId String
  managerId   String?
  approverRole Role          @default(MANAGER)
  status      ApprovalStatus @default(PENDING)
  reason      String?
  createdAt   DateTime       @default(now())
  quotation   Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  manager     User?          @relation("ManagerApprovals", fields: [managerId], references: [id], onDelete: SetNull)

  @@index([quotationId, status])
}

model Negotiation {
  id                       String    @id @default(cuid())
  quotationId              String
  customerId               String
  requestedDiscountPercent Decimal   @db.Decimal(5, 2)
  message                  String    @db.Text
  versionNumber            Int
  createdAt                DateTime  @default(now())
  quotation                Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  customer                 Customer  @relation(fields: [customerId], references: [id])
}

model Warehouse {
  id          String                @id @default(cuid())
  companyId   String
  name        String
  city        String
  address     String?
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventory   Inventory[]
  allocations InventoryAllocation[]
}

model Inventory {
  id          String    @id @default(cuid())
  companyId   String
  warehouseId String
  productId   String
  quantity    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([companyId, productId])
}

model InventoryAllocation {
  id           String     @id @default(cuid())
  salesOrderId String
  warehouseId  String?
  productId    String
  quantity     Int
  isBackorder  Boolean    @default(false)
  createdAt    DateTime   @default(now())
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  product      Product    @relation(fields: [productId], references: [id])
}

model SalesOrder {
  id                   String                @id @default(cuid())
  companyId            String
  customerId           String
  quotationId          String                @unique
  status               OrderStatus           @default(CREATED)
  total                Decimal               @db.Decimal(15, 2)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer             Customer              @relation(fields: [customerId], references: [id])
  quotation            Quotation             @relation(fields: [quotationId], references: [id])
  items                SalesOrderItem[]
  inventoryAllocations InventoryAllocation[]
  invoice              Invoice?
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  productId    String
  quantity     Int
  unitPrice    Decimal    @db.Decimal(15, 2)
  lineTotal    Decimal    @db.Decimal(15, 2)
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id])
}

model Invoice {
  id            String        @id @default(cuid())
  companyId     String
  salesOrderId  String        @unique
  invoiceNumber String        @unique
  subtotal      Decimal       @db.Decimal(15, 2)
  taxTotal      Decimal       @db.Decimal(15, 2)
  total         Decimal       @db.Decimal(15, 2)
  status        InvoiceStatus @default(ISSUED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesOrder    SalesOrder    @relation(fields: [salesOrderId], references: [id])
}

model DealHealth {
  id              String    @id @default(cuid())
  quotationId     String
  riskScore       Int
  riskLevel       String
  reasons         Json
  recommendations Json
  rawResponse     Json?
  createdAt       DateTime  @default(now())
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  userId     String?
  entityType String
  entityId   String
  action     String
  metadata   Json?
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, entityType, entityId])
}
